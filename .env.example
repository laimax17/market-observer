# Copy to .env and fill in. .env is gitignored.

# --- LLM (DeepSeek, OpenAI-compatible) ---
MO_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MO_DEEPSEEK_BASE_URL=https://api.deepseek.com
MO_DEEPSEEK_MODEL=deepseek-chat

# --- Discord ---
MO_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# --- Behaviour ---
# Comma-separated symbols always pinned into the watchlist (e.g. index ETFs).
MO_PINNED_SYMBOLS=SPY,QQQ
# Total watchlist size (pinned symbols count toward this).
MO_WATCHLIST_SIZE=10
# LLM sampling
MO_LLM_TEMPERATURE=0.2
MO_LLM_TIMEOUT_SECONDS=60
MO_LLM_MAX_RETRIES=2
# Where local markdown archives are written.
MO_OUTPUT_DIR=output
